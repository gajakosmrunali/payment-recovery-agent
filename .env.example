# Copy this file to .env and adjust as needed.
# The project runs perfectly with zero changes to this file (MOCK mode).

# --- Mode -------------------------------------------------------------
# true  -> no real Razorpay API calls are made; outcomes are simulated.
# false -> real calls are made to Razorpay's TEST-mode API using the
#          credentials below (requires a Razorpay test account).
USE_MOCK_RAZORPAY=true

# --- Razorpay TEST-mode credentials (only needed if USE_MOCK_RAZORPAY=false) ---
# Get these from https://dashboard.razorpay.com/app/keys (Test Mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Storage ------------------------------------------------------------
DATABASE_PATH=data/agent.db
SYNTHETIC_DATA_PATH=data/synthetic_payments.json

# --- Synthetic batch ------------------------------------------------------
SYNTHETIC_BATCH_SIZE=60
RANDOM_SEED=42

# --- Recovery policy tuning ----------------------------------------------
MAX_RETRY_ATTEMPTS=2
SMART_RETRY_DELAY_HOURS=6
